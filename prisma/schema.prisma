generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth.js (Prisma adapter) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // credentials provider
  passwordHash String?

  // pesa profile
  displayName String?
  salary      Int      @default(0)
  currency    String   @default("GH₵")
  monthLabel  String   @default("This month")
  // Calendar month ("YYYY-MM") the live disbursement tally (bucket.allocated)
  // belongs to. When the calendar advances past it we roll the month over.
  activeMonth String?

  // pesa settings flags
  roundUpsEnabled   Boolean @default(false)
  roundUpStep       Int     @default(50)
  paydayRemindersOn Boolean @default(false)
  paydayDayOfMonth  Int?
  appLockEnabled    Boolean @default(false)
  appLockPinHash    String?
  onboardedAt       DateTime?

  // push notification prefs
  pushPaydayOn    Boolean @default(false)
  pushBucketHitOn Boolean @default(true)
  pushWrapOn      Boolean @default(true)
  pushBillsDueOn  Boolean @default(true)

  // auto-disburse on payday using last month's template
  autoPaydayOn Boolean @default(false)

  accounts          Account[]
  sessions          Session[]
  buckets           Bucket[]
  txns              Transaction[]
  pushSubscriptions PushSubscription[]
  incomeSources     IncomeSource[]
  bankTxns          BankTransaction[]
  bankAccounts      BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Pesa domain ----------

model Bucket {
  id             String    @id @default(cuid())
  userId         String
  name           String
  target         Int
  allocated      Int       @default(0)
  spent          Int       @default(0)
  color          String
  icon           String
  priority       Int
  kind           String
  dueDayOfMonth  Int?
  // If true, unspent balance (allocated - spent) rolls into next month's
  // starting allocated instead of resetting to zero at rollover.
  carryOver      Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  txns Transaction[]

  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  bucketId   String
  amount     Int
  note       String
  method     String
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  transferId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket Bucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([bucketId, occurredAt])
  @@index([transferId])
}

model IncomeSource {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Int
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id         String    @id @default(cuid())
  userId     String
  name       String
  icon       String    @default("wallet")
  // Disbursements and the monthly income credit always target the primary
  // account (see lib/bank.ts `getPrimaryAccountId`). Exactly one per user.
  isPrimary  Boolean   @default(false)
  balance    Int       @default(0)
  order      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  txns BankTransaction[]

  @@index([userId])
}

model BankTransaction {
  id        String @id @default(cuid())
  userId    String
  accountId String
  // positive = credit (income/manual add), negative = debit (pot disburse/spend)
  amount     Int
  kind       String
  note       String
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  // Links the two legs of an account-to-account transfer.
  transferId String?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([transferId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
