# Database
# - Development: the local Postgres from `npm run db:dev` (scripts/dev-db.mjs).
#   Never point a dev machine at the production database.
# - Production (Vercel): the Vercel <-> Neon integration injects both values.
#   DATABASE_URL is the pooled URL; DATABASE_URL_UNPOOLED is the direct one
#   that `prisma migrate deploy` uses (schema.prisma `directUrl`).
DATABASE_URL="postgresql://pesa:pesa@localhost:5433/pesa"
DATABASE_URL_UNPOOLED="postgresql://pesa:pesa@localhost:5433/pesa"

# Auth.js v5
# - AUTH_SECRET: generate with `npx auth secret`
# - AUTH_URL: the public origin. Production: https://pesa.edtmsys.com (required).
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID)
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (https://resend.com) — used for magic-link sign-in and payday reminder emails
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Pesa <onboarding@resend.dev>"

# Web push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:amankrahjay@gmail.com"

# Vercel Cron secret — used to authorize /api/cron/* requests
# Generate any random string; set the same value in Vercel project env.
CRON_SECRET=""

# Mobile app Bearer-JWT signing secret (separate from AUTH_SECRET so mobile
# sessions can be rotated/revoked independently of the web cookie session).
# Generate with: openssl rand -hex 32 (must be at least 32 characters)
MOBILE_JWT_SECRET=""

# Dev/test only: set to 1 to switch rate limits off locally (integration tests
# register many throwaway accounts from one IP). Ignored in production.
# RATE_LIMITS_DISABLED=1

# Phone push (Firebase Cloud Messaging HTTP v1): the Firebase service-account
# JSON, raw or base64. Leave unset to keep phone push off (see
# docs/FIREBASE_SETUP.md).
# FCM_SERVICE_ACCOUNT=
